# PharmaGuard AI — environment variables
# =========================================
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.

# ── OpenRouter (preferred live AI provider) ──────────────────────────────────
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Recommended free models (non-thinking, reliable text output):
#   meta-llama/llama-3.1-8b-instruct:free
#   mistralai/mistral-7b-instruct:free
#   google/gemma-3-4b-it:free
# "openrouter/free" routes to whichever free model OpenRouter selects (may vary)
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# ── IBM watsonx.ai (optional fallback provider) ──────────────────────────────
WATSONX_API_KEY=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=
WATSONX_MODEL_ID=ibm/granite-13b-chat-v2
